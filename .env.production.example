# ==============================================================================
# AQUORA AI — Production Environment Variables Configuration Template
# Copy this file to .env.production and customize with verified production credentials.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AQUORA AI"
VERSION="1.0.0"
ENVIRONMENT="production"

# Network Binding
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# SQLite Database Persistence (Inside Docker Volume / Host Directory)
DATABASE_URL="sqlite:////app/data/aquora.db"

# Cryptographic Authentication Security
# Generate via: openssl rand -hex 32
SECRET_KEY="aquora-prod-secret-change-me-to-a-cryptographically-random-64-char-string"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=["https://aquora.kerala.gov.in", "http://localhost:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# Outbound Emergency Alert Channels
# ------------------------------------------------------------------------------

# Safe Test Mode (Set to "false" only when external alert delivery is verified and authorized)
ALERT_TEST_MODE="false"

# 1. HTTP Webhook Gateway (Discord, Slack, PagerDuty, or Generic REST Incident Webhook)
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"
ALERT_WEBHOOK_AUTH_TOKEN=""

# 2. SMTP Email Gateway (SendGrid, AWS SES, Resend, or Departmental Mail Server)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USERNAME="apikey"
SMTP_PASSWORD="your_sendgrid_api_key_here"
ALERT_FROM_EMAIL="alerts@aquora.kerala.gov.in"
ALERT_TO_EMAIL="eoc-officer@ksdma.kerala.gov.in"

# 3. SMS Gateway (Twilio REST API)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_FROM_NUMBER="+15551234567"
ALERT_TO_PHONE="+919876543210"

# ------------------------------------------------------------------------------
# Live Telemetry Providers & Meteorological APIs
# ------------------------------------------------------------------------------

# Open-Meteo Weather & SRTM Elevation API
OPEN_METEO_API_ENABLED="true"
OPEN_METEO_TIMEOUT_SECONDS=4.0
OPEN_METEO_CACHE_TTL_SECONDS=900.0

# Official National Water Informatics Centre (NWIC / India-WRIS)
# Set your registered state agency API key to enable live Indian telemetry stream
NWIC_API_KEY=""
NWIC_API_BASE_URL="https://nwdp.nwic.gov.in/api/v1"

# USGS Instantaneous Streamflow Telemetry (Reference River Station)
USGS_API_BASE_URL="https://waterservices.usgs.gov/nwis/iv/"
USGS_DEFAULT_SITE="11164500"

# Optional Gemini API Key for Automated Incident Summaries
GEMINI_API_KEY=""

