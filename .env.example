# ==============================================================================
# AQUORA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in the project root or backend/.env and frontend/.env.
# IMPORTANT: Never commit actual secret keys or .env files to version control!
#
# RUNNING WITHOUT CREDENTIALS (ZERO-KEY BASELINE):
# AQUORA AI is engineered to run out-of-the-box without requiring paid API keys:
# 1. River Telemetry: USGS NWIS live stream (Stanford Creek) works publicly with NO API key.
#    Ramamangalam Bridge falls back to verified official Kerala SW historical telemetry archives.
# 2. Outbound Alerts: Operates in Safe Test Mode (ALERT_TEST_MODE=true) with full payload validation
#    and audit logging without external side-effects.
# 3. Satellite Cartography: Leaflet renders OpenStreetMap (streets), CartoDB (dark matter), and
#    Esri World Imagery (authentic public earth observation satellite imagery) without keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CORE & SERVER CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# SQLite Database URL - defaults to predictable local path (backend/aquora.db)
DATABASE_URL=sqlite:///./backend/aquora.db

# CORS Allowed Origins (Comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. LIVE RIVER WATER-LEVEL TELEMETRY (Backend Only)
# ------------------------------------------------------------------------------
# Provider A: U.S. Geological Survey (USGS) National Water Information System (NWIS)
# - Source: U.S. Geological Survey (USGS) Instantaneous Values Service
# - Website: https://waterservices.usgs.gov/nwis/iv/
# - Credential Requirement: NONE (Public Government REST API, no key required)
# - Default Station: 11164500 (San Francisquito Creek at Stanford, CA)
# - Testing: GET /api/v1/river-data/USGS-11164500 returns real-time stage (m) and streamflow (m3/s)
USGS_API_BASE_URL=https://waterservices.usgs.gov/nwis/iv/
USGS_DEFAULT_SITE=11164500
USGS_TIMEOUT_SECONDS=6.0
USGS_CACHE_TTL_SECONDS=180.0

# Provider B: National Water Informatics Centre (NWIC) / India-WRIS
# - Source: Ministry of Jal Shakti, Department of Water Resources, Government of India
# - Website: https://nwdp.gov.in (National Water Data Portal)
# - Credential Requirement: Official government agency account approval required.
# - If unconfigured: Station gracefully defaults to verified Kerala SW historical archive
#   (RAMAMANGALAM BRIDGE: 2.162m, 10-Mar-2025 08:30 IST) with explicit UNAVAILABLE live status.
# - Testing: GET /api/v1/river-data/RAMAMANGALAM-BRIDGE
NWIC_API_KEY=your_nwic_api_key_here
NWIC_API_BASE_URL=https://nwdp.gov.in/api/v1
NWIC_TIMEOUT_SECONDS=5.0
NWIC_CACHE_TTL_SECONDS=300.0

# ------------------------------------------------------------------------------
# 3. OUTBOUND EMERGENCY ALERTS & NOTIFICATIONS (Backend Only)
# ------------------------------------------------------------------------------
# Safe Test Mode:
# When true, payload is strictly validated and simulated without external network side-effects.
# Set to false only when valid webhook or SMTP credentials are configured.
ALERT_TEST_MODE=false

# Channel A: Authenticated HTTP Webhook
# - Supports: Generic Incident Management APIs, Discord Webhooks, Slack Incoming Webhooks, PagerDuty
# - Where to get:
#     - Free Testing: https://webhook.site or https://httpbin.org/post
#     - Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
#     - Slack: https://api.slack.com/messaging/webhooks
# - Account/Billing: Free on Discord, Slack, and Webhook.site
# - Testing: POST /api/v1/alerts/test or POST /api/v1/alerts/dispatch
ALERT_WEBHOOK_URL=https://webhook.site/your-endpoint-or-pagerduty-url
ALERT_WEBHOOK_AUTH_TOKEN=your_optional_bearer_token

# Channel B: Standard SMTP Email
# - Supports: SendGrid, Resend, AWS SES, Mailgun, Postmark, or custom SMTP server
# - Where to get:
#     - SendGrid: https://sendgrid.com (Free tier: 100 emails/day)
#     - Resend: https://resend.com (Free tier: 100 emails/day)
#     - Mailtrap: https://mailtrap.io (Free testing sandbox)
# - Account/Billing: Free tier available from email service providers
# - Port: 587 (STARTTLS recommended) or 465 (SSL/TLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
ALERT_FROM_EMAIL=alerts@aquora.local
ALERT_TO_EMAIL=incident-response@safety.gov

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI EXPLANATIONS (Backend Only)
# ------------------------------------------------------------------------------
# Google Gemini API key for narrative AI hazard descriptions
# - Where to get: https://aistudio.google.com/
# - Account/Billing: Free tier available
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. FRONTEND SATELLITE MAPPING & CLIENT CONFIGURATION (Frontend Only)
# ------------------------------------------------------------------------------
# Notice: In Vite, variables exposed to the frontend browser MUST start with VITE_.
#
# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Commercial High-Resolution Satellite Imagery (Mapbox Satellite Streets)
# - Where to get: https://account.mapbox.com/ (Tokens -> Default public token)
# - Account/Billing: Free tier allows up to 50,000 map loads per month. Credit card may be required for setup.
# - If unconfigured: Leaflet automatically renders authentic public Earth Observation satellite
#   tiles via Esri World Imagery (ArcGIS/USGS) with transparent status notice and 0 blockers!
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Optional Google Maps Key (for alternative Google Maps embeds)
# - Where to get: Google Cloud Console -> APIs & Services -> Credentials -> Maps JavaScript API
# - Account/Billing: Requires Google Cloud billing account setup.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
