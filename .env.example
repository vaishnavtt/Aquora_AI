# AQUORA AI - Environment Variables Template
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit actual secret keys or .env files to version control!

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./backend/aquora.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI Explanations (Google Gemini API)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (Used when running frontend)
# Google Maps JavaScript API Key
# Get a key from Google Cloud Console with Maps JavaScript API enabled
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_API_BASE_URL=http://localhost:8000/api/v1
