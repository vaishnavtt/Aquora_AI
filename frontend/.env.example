# ==============================================================================
# AQUORA AI — FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local in the frontend directory.
# All frontend environment variables MUST begin with VITE_ to be exposed to Vite.
# NEVER commit secrets or production API keys to version control.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Commercial High-Resolution Satellite Imagery (Mapbox Satellite Streets)
# - Website: https://account.mapbox.com/
# - How to obtain: Sign up for Mapbox, navigate to Access Tokens, and copy the default public token.
# - Free tier: 50,000 monthly map loads.
# - Fallback behavior: If unset or invalid, the map automatically defaults to authentic
#   public Earth Observation Satellite Imagery via Esri World Imagery (ArcGIS/USGS).
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Optional Google Maps JavaScript API Key
# - Website: https://console.cloud.google.com/
# - Requires billing account and Maps JavaScript API enabled.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
