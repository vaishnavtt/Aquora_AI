# ==============================================================================
# AQUORA AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env
# IMPORTANT: Never commit actual secret keys or .env files to version control!
#
# RUNNING WITHOUT CREDENTIALS (ZERO-KEY BASELINE):
# AQUORA AI is engineered to run out-of-the-box without requiring paid API keys:
# 1. River Telemetry: USGS NWIS live stream (Stanford Creek) works publicly with NO API key.
#    Ramamangalam Bridge falls back to verified official Kerala SW historical telemetry archives.
# 2. Outbound Alerts: Operates in Safe Test Mode (ALERT_TEST_MODE=true) with full payload validation
#    and audit logging without external side-effects.
# 3. Weather: Open-Meteo free API requires ZERO API keys or registration.
# ==============================================================================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# SQLite Database URL - defaults to predictable local path
DATABASE_URL=sqlite:///./aquora.db

# CORS Allowed Origins (Comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# LIVE RIVER WATER-LEVEL TELEMETRY
# ------------------------------------------------------------------------------
# Provider A: U.S. Geological Survey (USGS) NWIS (No key needed)
USGS_API_BASE_URL=https://waterservices.usgs.gov/nwis/iv/
USGS_DEFAULT_SITE=11164500
USGS_TIMEOUT_SECONDS=6.0
USGS_CACHE_TTL_SECONDS=180.0

# Provider B: National Water Informatics Centre (NWIC) / India-WRIS
NWIC_API_KEY=your_nwic_api_key_here
NWIC_API_BASE_URL=https://nwdp.gov.in/api/v1
NWIC_TIMEOUT_SECONDS=5.0
NWIC_CACHE_TTL_SECONDS=300.0

# ------------------------------------------------------------------------------
# LIVE WEATHER & ELEVATION API (Open-Meteo, Free, No key needed)
# ------------------------------------------------------------------------------
OPEN_METEO_API_ENABLED=true
OPEN_METEO_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# OUTBOUND EMERGENCY ALERTS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Safe Test Mode (Set to false only when upstream credentials are valid)
ALERT_TEST_MODE=true

# Channel A: Authenticated HTTP Webhook
ALERT_WEBHOOK_URL=https://webhook.site/your-endpoint-or-pagerduty-url
ALERT_WEBHOOK_AUTH_TOKEN=your_optional_bearer_token

# Channel B: Standard SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
ALERT_FROM_EMAIL=alerts@aquora.local
ALERT_TO_EMAIL=incident-response@safety.gov

# Channel C: SMS & Mobile Notifications (Twilio REST API)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
ALERT_TO_PHONE=+919876543210

# ------------------------------------------------------------------------------
# OPTIONAL AI EXPLANATIONS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
